{
  "name": "paper-loom",
  "version": "0.9.3",
  "private": true,
  "author": "GreyWolf1101",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/GreyWolf1101/PaperLoom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreyWolf1101/PaperLoom.git"
  },
  "bugs": {
    "url": "https://github.com/GreyWolf1101/PaperLoom/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "A local-first research workbench for evidence-grounded paper reading, comparison, citation navigation and synthesis.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:update": "npm run build && node scripts/build-update-release.cjs",
    "verify:update": "electron scripts/verify-update-feed.cjs",
    "test:cjs": "node --test tests/*.test.cjs",
    "test:ts": "tsx --test tests/*.test.ts",
    "test": "npm run test:cjs && npm run test:ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.13",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "1.24.0",
    "mammoth": "1.12.0",
    "mathlive": "^0.110.0",
    "mathml2omml": "^0.5.0",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "cross-env": "10.1.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wait-on": "9.0.10"
  },
  "overrides": {
    "js-yaml": "^4.3.0"
  },
  "build": {
    "appId": "io.paperloom.reader",
    "productName": "PaperLoom",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "PaperLoom-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
